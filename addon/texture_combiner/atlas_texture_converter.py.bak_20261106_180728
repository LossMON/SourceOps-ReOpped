class SOURCEOPS_OT_CombineTextures(bpy.types.Operator, bpy_extras.io_utils.ExportHelper):
    bl_idname = 'sourceops.combine_textures'
    bl_label = 'Save Atlas to...'
    bl_description = 'Combine selected materials into a texture atlas and choose save location'
    bl_options = {'REGISTER', 'UNDO'}

    filename_ext = ".png"
    filter_glob: bpy.props.StringProperty(default="*.png", options={'HIDDEN'})

    @classmethod
    def poll(cls, context):
        sourceops = getattr(context.scene, 'sourceops', None)
        return bool(sourceops and sourceops.combiner_target_collection)

    def invoke(self, context, event):
        sourceops = context.scene.sourceops
        target_col = sourceops.combiner_target_collection
        if target_col:
            self.filepath = f"{target_col.name}_Atlas.png"
        else:
            self.filepath = "Atlas.png"
        return super().invoke(context, event)

    def execute(self, context):
        sourceops = context.scene.sourceops
        target_col = sourceops.combiner_target_collection
        size_choice = getattr(sourceops, 'combiner_atlas_size', '2048')

        mesh_objs = [o for o in target_col.all_objects if o.type == 'MESH']
        all_materials = []
        seen = set()
        for o in mesh_objs:
            for slot in o.material_slots:
                if slot.material and slot.material not in seen:
                    seen.add(slot.material)
                    all_materials.append(slot.material)

        selected_mats = [m for m in all_materials if getattr(m, 'sourceops_combine', True)]
        if not selected_mats:
            self.report({'ERROR'}, 'No materials selected to combine!')
            return {'CANCELLED'}

        try:
            if size_choice in {'QUAD', 'PO2', 'AUTO'}:
                objs, filepath = create_smc_atlas(
                    target_col=target_col,
                    custom_filepath=self.filepath,
                    selected_mats=selected_mats,
                    size_mode=size_choice,
                    crop=getattr(sourceops, 'combiner_crop', True),
                    pixel_art=getattr(sourceops, 'combiner_pixel_art', False),
                    diffuse_size=getattr(sourceops, 'combiner_diffuse_size', 32),
                    gaps=getattr(sourceops, 'combiner_gaps', 0)
                )
            else:
                atlas_size = int(size_choice)
                objs, filepath = create_bake_atlas(
                    target_col=target_col,
                    custom_filepath=self.filepath,
                    selected_mats=selected_mats,
                    atlas_size=atlas_size,
                    bake_margin=getattr(sourceops, 'combiner_bake_margin', 12),
                    uv_margin=getattr(sourceops, 'combiner_uv_margin', 0.012)
                )

            self.report({'INFO'}, f"Combined textures across {len(objs)} meshes ({size_choice})")
            return {'FINISHED'}
        except Exception as e:
            traceback.print_exc()
            popup(f"{e}", error=True)
            self.report({'ERROR'}, f"Atlas creation failed: {e}")
            return {'CANCELLED'}


class SOURCEOPS_OT_CombinerSelectAllMats(bpy.types.Operator):
    bl_idname = 'sourceops.combiner_select_all_mats'
    bl_label = 'Select All'
    bl_description = 'Select all materials across the collection'
    bl_options = {'INTERNAL', 'UNDO'}

    def execute(self, context):
        col = context.scene.sourceops.combiner_target_collection
        if col:
            for o in col.all_objects:
                if o.type == 'MESH':
                    for slot in o.material_slots:
                        if slot.material:
                            slot.material.sourceops_combine = True
        return {'FINISHED'}


