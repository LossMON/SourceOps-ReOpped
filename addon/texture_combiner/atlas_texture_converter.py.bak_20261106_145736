import bpy
import os
import re
import math
import traceback
import numpy as np

LOG_PREFIX = '[TEXTURE COMBINER] '
TEMP_MATERIAL_PREFIX = '__SourceOps_Bake__'


def log(*items):
    print(LOG_PREFIX + ' '.join(str(v) for v in items), flush=True)


def popup(message, *, error=False):
    log(('ERROR: ' if error else 'SUCCESS: ') + message)
    try:
        lines = [message[i:i+95] for i in range(0, len(message), 95)]
        def draw(self, context):
            for line in lines[:7]:
                self.layout.label(text=line)
        bpy.context.window_manager.popup_menu(
            draw, title='Texture Combiner — ' + ('Error' if error else 'Done'),
            icon='ERROR' if error else 'CHECKMARK')
    except Exception:
        pass


def source_uv_name(obj):
    uvs = obj.data.uv_layers
    if not uvs:
        uv = obj.data.uv_layers.new(name='UVMap')
        return uv.name
    chosen = next((u for u in uvs if u.active_render), None) or uvs.active
    return chosen.name


def unused_png_path(name, w, h):
    stem = re.sub(r'[^a-zA-Z0-9_.-]+', '_', name).strip('._') or 'Atlas'
    folder = os.path.dirname(bpy.data.filepath) if bpy.data.filepath else bpy.app.tempdir
    candidate = os.path.join(folder, f"{stem}_ATLAS_{w}x{h}.png")
    i = 1
    while os.path.exists(candidate):
        candidate = os.path.join(folder, f"{stem}_ATLAS_{w}x{h}_{i:02d}.png")
        i += 1
    return candidate


def new_atlas_material(image, uv_name, name):
    mat = bpy.data.materials.new(name=name)
    mat.use_nodes = True
    tree = mat.node_tree
    tree.nodes.clear()
    out = tree.nodes.new('ShaderNodeOutputMaterial')
    out.location = (500, 100)
    shader = tree.nodes.new('ShaderNodeBsdfPrincipled')
    shader.location = (230, 100)
    if 'Metallic' in shader.inputs:
        shader.inputs['Metallic'].default_value = 0
    if 'Roughness' in shader.inputs:
        shader.inputs['Roughness'].default_value = 0.5
    img = tree.nodes.new('ShaderNodeTexImage')
    img.location = (-50, 100)
    img.image = image
    img.interpolation = 'Linear'
    uv = tree.nodes.new('ShaderNodeUVMap')
    uv.location = (-270, 100)
    uv.uv_map = uv_name
    tree.links.new(uv.outputs['UV'], img.inputs['Vector'])
    tree.links.new(img.outputs['Color'], shader.inputs['Base Color'])
    tree.links.new(shader.outputs['BSDF'], out.inputs['Surface'])
    return mat


# ==============================================================================
# METHOD 1: SMC 2D DIRECT PACKING (Quadratic, Power of 2, Automatic)
# ==============================================================================

def get_material_true_color(mat):
    if not mat:
        return (0.8, 0.8, 0.8, 1.0)
    if hasattr(mat, 'diffuse_color'):
        dc = mat.diffuse_color
        if any(c > 0.05 for c in dc[:3]):
            return (dc[0], dc[1], dc[2], 1.0)
    if mat.use_nodes and mat.node_tree:
        for node in mat.node_tree.nodes:
            if node.type == 'BSDF_PRINCIPLED':
                sock = node.inputs.get('Base Color')
                if sock and not sock.is_linked:
                    c = sock.default_value
                    return (c[0], c[1], c[2], 1.0)
            elif node.type == 'RGB':
                c = node.outputs[0].default_value
                return (c[0], c[1], c[2], 1.0)
            elif node.type == 'BSDF_DIFFUSE':
                sock = node.inputs.get('Color')
                if sock and not sock.is_linked:
                    c = sock.default_value
                    return (c[0], c[1], c[2], 1.0)
    return (0.8, 0.8, 0.8, 1.0)


def get_material_image_data_smc(mat, diffuse_size=64):
    """
    Returns (numpy_array, width, height, has_real_image)
    """
    if mat and mat.use_nodes and mat.node_tree:
        img_node = next((n for n in mat.node_tree.nodes if n.type == 'TEX_IMAGE' and n.image), None)
        if img_node and img_node.image:
            img = img_node.image
            if img.source == 'FILE' and (img.size[0] == 0 or not img.has_data):
                try:
                    img.reload()
                except Exception:
                    pass
            w, h = img.size
            if w > 0 and h > 0:
                try:
                    arr = np.empty(w * h * 4, dtype=np.float32)
                    img.pixels.foreach_get(arr)
                    return arr.reshape((h, w, 4)), w, h, True
                except Exception:
                    pass

    # Solid diffuse color block (use minimum 64px to prevent any mipmap black bleeding)
    block_size = max(64, diffuse_size)
    col = get_material_true_color(mat)
    arr = np.tile(np.array(col, dtype=np.float32), (block_size, block_size, 1))
    return arr, block_size, block_size, False


def next_power_of_2(x):
    return 1 if x <= 1 else 2 ** int(math.ceil(math.log2(x)))


def pack_rectangles_shelf(rect_items, target_w, gap=0):
    placements = {}
    current_x = gap
    current_y = gap
    shelf_h = 0
    max_x_used = 0

    for key, w, h in rect_items:
        eff_w = w + gap

        if current_x + w + gap > target_w:
            current_y += shelf_h + gap
            current_x = gap
            shelf_h = 0

        placements[key] = (current_x, current_y, w, h)
        current_x += eff_w
        shelf_h = max(shelf_h, h)
        max_x_used = max(max_x_used, current_x)

    total_h = current_y + shelf_h + gap
    total_w = max_x_used
    return total_w, total_h, placements


def compute_smc_atlas_layout(items, size_mode='QUAD', gap=0):
    sorted_items = sorted(items, key=lambda it: (it[2], it[1]), reverse=True)
    max_item_w = max(it[1] for it in sorted_items)
    total_area = sum((it[1] + gap) * (it[2] + gap) for it in sorted_items)
    po2_candidates = [64, 128, 256, 512, 1024, 2048, 4096]

    if size_mode == 'QUAD':
        chosen_s = 4096
        chosen_places = {}
        for s in po2_candidates:
            if s < max_item_w + 2 * gap or s * s < total_area:
                continue
            used_w, used_h, places = pack_rectangles_shelf(sorted_items, s, gap)
            if used_h <= s:
                chosen_s = s
                chosen_places = places
                break
        if not chosen_places:
            _, _, chosen_places = pack_rectangles_shelf(sorted_items, 4096, gap)
            chosen_s = 4096
        return chosen_s, chosen_s, chosen_places

    elif size_mode == 'PO2':
        best_area = float('inf')
        best_w, best_h = 4096, 4096
        best_places = {}
        for w_cand in po2_candidates:
            if w_cand < max_item_w + 2 * gap or w_cand > 4096:
                continue
            used_w, used_h, places = pack_rectangles_shelf(sorted_items, w_cand, gap)
            h_po2 = min(4096, next_power_of_2(used_h))
            if used_h <= 4096:
                area = w_cand * h_po2
                if area < best_area:
                    best_area = area
                    best_w = w_cand
                    best_h = h_po2
                    best_places = places
        if not best_places:
            _, _, best_places = pack_rectangles_shelf(sorted_items, 4096, gap)
            best_w, best_h = 4096, 4096
        return best_w, best_h, best_places

    else:
        # AUTO
        target_w = max(max_item_w + 2 * gap, int(math.ceil(math.sqrt(total_area))))
        target_w = min(4096, target_w)
        used_w, used_h, places = pack_rectangles_shelf(sorted_items, target_w, gap)
        return max(64, min(4096, used_w)), max(64, min(4096, used_h)), places


def create_smc_atlas(target_col, selected_mats=None, size_mode='QUAD', crop=True, pixel_art=False, diffuse_size=32, gaps=0):
    mesh_objs = [o for o in target_col.all_objects if o.type == 'MESH']
    participating_objs = [o for o in mesh_objs if {s.material for s in o.material_slots if s.material}.intersection(set(selected_mats))]

    log(f'Running SMC 2D Packing ({size_mode}) on {len(participating_objs)} separate meshes...')

    # Step 1: Extract images and diffuse color blocks
    mat_data = {}
    mat_is_real_img = {}
    rect_items = []
    for mat in selected_mats:
        arr, w, h, has_img = get_material_image_data_smc(mat, diffuse_size=max(64, diffuse_size))
        mat_data[mat] = arr
        mat_is_real_img[mat] = has_img
        rect_items.append((mat, w, h))

    # Step 2: Calculate packing layout
    atlas_w, atlas_h, placements = compute_smc_atlas_layout(rect_items, size_mode=size_mode, gap=gaps)

    # Initialize atlas with clean neutral/solid background (no pure transparent black that bleeds)
    atlas_arr = np.zeros((atlas_h, atlas_w, 4), dtype=np.float32)

    # Fill background with first material's ambient color to eliminate dark edges
    bg_col = mat_data[selected_mats[0]][0, 0, :]
    atlas_arr[:, :, 0] = bg_col[0]
    atlas_arr[:, :, 1] = bg_col[1]
    atlas_arr[:, :, 2] = bg_col[2]
    atlas_arr[:, :, 3] = 1.0

    for mat, (x, y, w, h) in placements.items():
        img_arr = mat_data[mat]
        atlas_arr[y : y + h, x : x + w, :] = img_arr

    filepath = unused_png_path(target_col.name, atlas_w, atlas_h)
    new_img = bpy.data.images.new(
        name=f"{target_col.name}_ATLAS_{atlas_w}x{atlas_h}",
        width=atlas_w, height=atlas_h,
        alpha=False, float_buffer=False)
    new_img.colorspace_settings.name = 'sRGB'
    new_img.pixels.foreach_set(atlas_arr.ravel())
    new_img.filepath_raw = filepath
    new_img.file_format = 'PNG'
    new_img.save()

    atlas_uv_name = 'Atlas_UV'
    new_mat = new_atlas_material(new_img, atlas_uv_name, f"{target_col.name}_Atlas_Mat")

    # Step 3: Remap UVs
    for obj in participating_objs:
        orig_uv = next((u for u in obj.data.uv_layers if u.active_render), None) or obj.data.uv_layers.active
        if not orig_uv:
            orig_uv = obj.data.uv_layers.new(name='UVMap')
        orig_uv_name = orig_uv.name

        if atlas_uv_name in obj.data.uv_layers:
            obj.data.uv_layers.remove(obj.data.uv_layers[atlas_uv_name])
        new_uv = obj.data.uv_layers.new(name=atlas_uv_name)

        orig_uv_layer = obj.data.uv_layers[orig_uv_name].data
        atlas_uv_layer = new_uv.data

        for i in range(len(orig_uv_layer)):
            atlas_uv_layer[i].uv = orig_uv_layer[i].uv

        original_slots = [slot.material for slot in obj.material_slots]

        for poly in obj.data.polygons:
            slot_mat = original_slots[poly.material_index] if poly.material_index < len(original_slots) else None
            if slot_mat and slot_mat in selected_mats:
                x, y, w, h = placements[slot_mat]
                loops = poly.loop_indices
                has_real_img = mat_is_real_img.get(slot_mat, False)

                if not has_real_img:
                    # FIX: Solid color materials map to the SAFE CENTER of their color block.
                    # This prevents the UVs from ever landing on black borders or bleeding!
                    center_u = (x + w * 0.5) / atlas_w
                    center_v = (y + h * 0.5) / atlas_h
                    for l in loops:
                        atlas_uv_layer[l].uv = (center_u, center_v)
                else:
                    # Real Image: remap UV coordinates into texture rect
                    if crop:
                        min_u = math.floor(min(orig_uv_layer[l].uv.x for l in loops))
                        min_v = math.floor(min(orig_uv_layer[l].uv.y for l in loops))
                    else:
                        min_u = 0
                        min_v = 0

                    for l in loops:
                        u_orig = orig_uv_layer[l].uv.x - min_u
                        v_orig = orig_uv_layer[l].uv.y - min_v

                        # Clamp slightly inside texture borders to eliminate border bleed
                        u_clamped = max(0.001, min(0.999, u_orig))
                        v_clamped = max(0.001, min(0.999, v_orig))

                        new_u = (x + u_clamped * w) / atlas_w
                        new_v = (y + v_clamped * h) / atlas_h
                        atlas_uv_layer[l].uv = (new_u, new_v)

        obj_all_selected = all((m in selected_mats) for m in original_slots if m)
        if obj_all_selected:
            obj.data.materials.clear()
            obj.data.materials.append(new_mat)
            for poly in obj.data.polygons:
                poly.material_index = 0
        else:
            unselected_unique = []
            seen_unsel = set()
            for m in original_slots:
                if m and m not in selected_mats and m not in seen_unsel:
                    seen_unsel.add(m)
                    unselected_unique.append(m)

            mat_to_idx = {m: 0 for m in selected_mats}
            for idx_u, m in enumerate(unselected_unique, start=1):
                mat_to_idx[m] = idx_u

            for poly in obj.data.polygons:
                orig_m = original_slots[poly.material_index] if poly.material_index < len(original_slots) else None
                poly.material_index = mat_to_idx.get(orig_m, 0)

            obj.data.materials.clear()
            obj.data.materials.append(new_mat)
            for m in unselected_unique:
                obj.data.materials.append(m)

        obj.data.uv_layers[atlas_uv_name].active_render = True
        obj.data.uv_layers.active = obj.data.uv_layers[atlas_uv_name]

    popup(f"Packed {size_mode} atlas on {len(participating_objs)} separate meshes! PNG: {filepath}")
    return participating_objs, filepath


